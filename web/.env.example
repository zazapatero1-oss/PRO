# Supabase project (dev or demo). Public values only; the Anthropic key never lives here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Edge functions base URL, normally ${VITE_SUPABASE_URL}/functions/v1
VITE_FUNCTIONS_URL=https://your-project.supabase.co/functions/v1
# Base path for GitHub Pages project sites, e.g. /face-q-conversation/ (default /)
VITE_BASE_PATH=/
# Set to 1 to run the whole app against in-memory fixtures (no backend needed)
VITE_MOCK=0
